{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing config. `npm run test:mutation` runs the full suite; CI runs the same thing and fails under the thresholds below.",
  "packageManager": "npm",
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.ts"
  },
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "coverageAnalysis": "perTest",
  "concurrency": 3,
  "timeoutMS": 20000,
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.spec.ts"
  ],
  "thresholds": { "high": 90, "low": 80, "break": 0 },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
